#!/usr/bin/bash
# The installer sets up the system to follow the PeplowPC image, but without checking signatures
# (the installer has no way to know our key). On first boot, switch to the same image with
# signature checking on, so every future update must be signed by PeplowPC.
# The switch is staged and takes effect at the next restart, like any other update.
set -euo pipefail

INFO=/usr/share/peplowpc/image-info.json
STAMP=/var/lib/peplowpc/signed-switch.done
target="$(jq -r '."image-ref" + ":" + ."image-tag"' "$INFO")"

echo "Switching to signed updates from ${target}"
bootc switch --enforce-container-sigpolicy "$target"

install -d -m0755 "$(dirname "$STAMP")"
date --iso-8601=seconds >"$STAMP"
echo "Signed updates enabled. Takes effect after the next restart."
