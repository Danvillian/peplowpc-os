#!/usr/bin/bash
# One-time SELinux relabel of /etc and /var (see peplowpc-relabel.service for why).
# restorecon only changes labels that are wrong, so on a healthy system this changes nothing.
# People's home folders are left alone: the installer does not write there, and they can be large.
set -euo pipefail

STAMP=/var/lib/peplowpc/relabel.done

changed="$(restorecon -R -v -e /var/home /etc /var 2>&1 | tee /dev/stderr | grep -c 'Relabeled' || true)"
install -d -m0755 "$(dirname "$STAMP")"
date --iso-8601=seconds >"$STAMP"
echo "SELinux relabel finished: ${changed} file(s) relabeled."
