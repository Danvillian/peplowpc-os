[Unit]
Description=PeplowPC: require signed system updates from now on
Documentation=https://github.com/Danvillian/peplowpc-os/blob/main/docs/ARCHITECTURE.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/peplowpc/signed-switch.done
ConditionPathExists=/etc/pki/containers/peplowpc.pub
# Started by peplowpc-signed-switch.timer so it never delays login.

[Service]
Type=oneshot
ExecStart=/usr/libexec/peplowpc/signed-switch
